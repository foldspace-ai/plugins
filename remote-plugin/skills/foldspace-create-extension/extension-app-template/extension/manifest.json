{
  "manifest_version": 3,
  "name": "App Name",
  "version": "0.1.0",
  "description": "App Name Extension",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://APP_DOMAIN/*",
    "*://*.APP_DOMAIN/*",
    "http://localhost/*",
    "https://script.eucerahive.io/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "csp_bypass_rules",
        "enabled": true,
        "path": "csp_rules.json"
      }
    ]
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.js"],
      "matches": ["*://APP_DOMAIN/*", "*://*.APP_DOMAIN/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://APP_DOMAIN/*",
        "*://*.APP_DOMAIN/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
