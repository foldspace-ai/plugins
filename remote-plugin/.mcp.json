{
  "mcpServers": {
    "foldspace": {
      "command": "npx",
      "args": [
        "-y",
        "@foldspace_npm/foldspace-mcp@latest"
      ],
      "env": {
        "FOLDSPACE_API_KEY": "${FOLDSPACE_API_KEY}"
      }
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--isolated"]
    }
  }
}
